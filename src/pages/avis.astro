---
import Layout from "@/layouts/Layout.astro";
import { FeedbackForm } from "@/components/FeedbackForm";
import Container from "@/components/Container.astro";
import { LandingH1 } from "@/components/Typography";
import { SEO_META } from "@/data.constants";
---

<Layout
  title={SEO_META.AVIS.title}
  description={SEO_META.AVIS.description}
  withPadding={true}
  noindex
>
  <Container>
    <LandingH1 className="text-center">Votre avis nous intéresse</LandingH1>
    <div class="mt-4 max-w-2xl mx-auto">
      <FeedbackForm client:load />
    </div>
  </Container>
</Layout>
