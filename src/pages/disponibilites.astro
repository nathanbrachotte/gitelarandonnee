---
import Card from "@/components/Card.astro";
import { H2, H3, LandingH1, Text } from "@/components/Typography";
import Layout from "@/layouts/Layout.astro";
import CalendarDirect from "@/components/CalendarDirect.astro";
import EmailBooking from "@/components/EmailBooking.astro";
import PricesSection from "@/components/PricesSection.astro";
import { SEO_META, LINKS } from "@/data.constants";
import Container from "@/components/Container.astro";
import { Button } from "@/components/ui/button";
import { Link } from "@/components/Link";
---

<Layout
  title={SEO_META.DISPONIBILITES_TARIFS.title}
  description={SEO_META.DISPONIBILITES_TARIFS.description}
  ignoreViewTransitions
  className="flex flex-col gap-12"
  breadcrumb="Réserver/Disponibilités"
>
  <Container>
    <LandingH1 className="text-center">Réserver/Disponibilités</LandingH1>
    <Card className="mt-3">
      <H2>Disponibilités</H2>
      <CalendarDirect />
    </Card>
    <Card className="mt-3">
      <H2>Réserver</H2>
      <EmailBooking />
      <div class="mt-8 flex flex-col">
        <H3>Ou via l'office du tourisme du Pays du Haut-Doubs</H3>
        <Text>Validation automatique mais inclut des frais de gestion.</Text>
        <Link href={LINKS.OFFICE_TOURISME_GITE.url} className="mt-3">
          <Button variant="outline">Réserver via l'office du tourisme</Button>
        </Link>
      </div>
    </Card>
    <Card className="mt-3">
      <PricesSection />
    </Card>
  </Container>
</Layout>
