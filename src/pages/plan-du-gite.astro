---
import Layout from "@/layouts/Layout.astro";
import { LandingH1 } from "@/components/Typography";
import RoomDetails from "@/components/RoomDetails.astro";
import { Image } from "astro:assets";
import { ZoomedImage } from "@/components/ZoomedImage";
import { SEO_META } from "@/data.constants";
import Container from "@/components/Container.astro";
import ContactForm from "@/components/ContactForm.astro";
import Card from "@/components/Card.astro";

const LABEL = "Plan du Gîte La Randonnée";
---

<Layout
  title={SEO_META.PLAN_DU_GITE.title}
  description={SEO_META.PLAN_DU_GITE.description}
  breadcrumb="Plan du Gîte"
>
  <Container>
    <LandingH1 className="text-center">{LABEL}</LandingH1>
    <Card className="mt-4">
      <div class="flex flex-col justify-center gap-4 mt-4 items-center">
        <div class="w-full lg:w-2/3">
          <ZoomedImage client:idle>
            <Image
              src="/plan.svg"
              alt="Plan du Gîte La Randonnée : 5 chambres, salon, cuisine et séjour, salle d'eau avec 4 douches, salle de bain"
              class={"w-full h-auto aspect-[9/5] object-cover"}
              width="2250"
              height="1250"
              loading="eager"
              fetchpriority="high"
            />
          </ZoomedImage>
        </div>
      </div>
    </Card>
    <RoomDetails />
  </Container>
  <Container>
    <ContactForm />
  </Container>
</Layout>
