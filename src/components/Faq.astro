---
import { LandingH2 } from "@/components/Typography";
import { FAQ } from "@/data.constants";

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: FAQ.map(({ question, answer }) => ({
    "@type": "Question",
    name: question,
    acceptedAnswer: { "@type": "Answer", text: answer },
  })),
};
---

<section id="faq" class="mt-12 flex justify-center px-4">
  <div class="container max-w-3xl">
    <LandingH2 className="text-center mb-8">Questions fréquentes</LandingH2>
    <div class="space-y-3">
      {
        FAQ.map(({ question, answer }) => (
          <details class="group bg-card border-2 rounded-lg">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 p-4 font-semibold text-primary">
              <h3>{question}</h3>
              <span
                class="shrink-0 transition-transform group-open:rotate-45 text-2xl leading-none"
                aria-hidden="true"
              >
                +
              </span>
            </summary>
            <p class="px-4 pb-4">{answer}</p>
          </details>
        ))
      }
    </div>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
</section>
