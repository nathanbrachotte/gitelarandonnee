---
import { LandingH2 } from "@/components/Typography";
import { FAQ } from "@/data.constants";
import { ArrowRight } from "lucide-react";

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: FAQ.map(({ question, answer }) => ({
    "@type": "Question",
    name: question,
    acceptedAnswer: { "@type": "Answer", text: answer },
  })),
};
---

<!-- Answers stay in the HTML: crawlers read them and the browser's find
     (Ctrl/Cmd+F) opens the matching question -->
<section id="faq" class="mt-12 flex justify-center px-4">
  <div class="container max-w-3xl">
    <LandingH2 className="text-center mb-8">Questions fréquentes</LandingH2>
    <div class="space-y-3">
      {
        FAQ.map((item) => (
          <details class="faq-item group bg-card border-2 rounded-lg transition-colors open:border-highlight">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 p-4 font-semibold text-primary [&::-webkit-details-marker]:hidden">
              <h3>{item.question}</h3>
              <span
                class="flex size-8 shrink-0 items-center justify-center rounded-full bg-primary/10 text-primary transition duration-300 ease-out group-open:rotate-[135deg] group-open:bg-highlight group-open:text-highlight-foreground"
                aria-hidden="true"
              >
                <svg
                  viewBox="0 0 24 24"
                  class="size-4"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                >
                  <path d="M12 5v14M5 12h14" />
                </svg>
              </span>
            </summary>
            <div class="px-4 pb-4">
              <p>{item.answer}</p>
              {"link" in item && item.link && (
                <a
                  href={item.link.href}
                  class="mt-3 inline-flex items-center gap-1 font-semibold text-highlight underline underline-offset-2"
                >
                  {item.link.label}
                  <ArrowRight className="size-4" aria-hidden="true" />
                </a>
              )}
            </div>
          </details>
        ))
      }
    </div>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
</section>
