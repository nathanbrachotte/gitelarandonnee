---
const ingenieCode = import.meta.env.PUBLIC_INGENIE_CODE;
const siteUrl = import.meta.env.PUBLIC_SITE_URL;

export type Props = {
  showTitle?: boolean;
};
---

<!-- Reserve the widget height up front so it does not shift the layout when injected -->
<div
  id="widget-fiche-ingenie-dispo-wrapper"
  class="min-h-[460px] lg:min-h-[420px] max-h-[460px] lg:max-h-[420px] overflow-hidden w-full"
  style="visibility: hidden"
>
  <div class="w-full" id="widget-fiche-ingenie-dispo"></div>
</div>

<script
  is:inline
  src="https://static.ingenie.fr/js/ScriptsLoader.js"
  type="text/javascript"></script>
<script
  is:inline
  src="https://static.ingenie.fr/widgets/dispo_resa/Client.js"
  type="text/javascript"></script>
<script is:inline define:vars={{ ingenieCode, siteUrl }}>
  // Widget pour les disponibilités uniquement
  const widget_dispo = new IngenieWidgetDispoResa.Client({
    code: "HLOBFC025334000496", // Code de la prestation
    url: "https://www.destination-haut-doubs.com", //(string) Url du site (dynamique)
    elementHtml: "widget-fiche-ingenie-dispo", //(string) Identifiant destination HTML du widget
    enable_dispo: true, // Active dispo
    enable_resa: false, // Désactive résa
    styles: {
      direction: "horizontal",
      responsiveAt: "900",
      inlineLabels: true,
    },
    dispo: {
      options: {
        templates: {},
      },
    },
  });

  widget_dispo.init();

  // The widget re-renders several times while loading. Keep it hidden until
  // its final render (the "last updated" footer) so those re-renders don't
  // count as layout shifts.
  const widgetWrapper = document.getElementById(
    "widget-fiche-ingenie-dispo-wrapper",
  );
  let revealTimeout;
  const reveal = () => {
    observer.disconnect();
    widgetWrapper.classList.remove(
      "max-h-[460px]",
      "lg:max-h-[420px]",
      "overflow-hidden",
    );
    widgetWrapper.classList.add("overflow-x-auto");
    widgetWrapper.style.visibility = "visible";
  };
  const observer = new MutationObserver(() => {
    if (widgetWrapper.querySelector(".dateMajPlanning") == null) {
      return;
    }
    clearTimeout(revealTimeout);
    revealTimeout = setTimeout(reveal, 150);
  });
  observer.observe(widgetWrapper, { childList: true, subtree: true });
  setTimeout(reveal, 5000);
</script>
