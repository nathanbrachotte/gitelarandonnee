---
const ingenieCode = import.meta.env.PUBLIC_INGENIE_CODE;
const siteUrl = import.meta.env.PUBLIC_SITE_URL;

export type Props = {
  showTitle?: boolean;
};
---

<!-- Fixed box: the widget renders after load, so it must not move or resize the layout -->
<div class="relative h-[400px]">
  <div
    class="absolute inset-x-0 top-0 max-w-full invisible"
    id="widget-fiche-ingenie-dispo"
  >
  </div>
</div>

<script
  is:inline
  src="https://static.ingenie.fr/js/ScriptsLoader.js"
  type="text/javascript"></script>
<script
  is:inline
  src="https://static.ingenie.fr/widgets/dispo_resa/Client.js"
  type="text/javascript"></script>
<script is:inline define:vars={{ ingenieCode, siteUrl }}>
  // Widget pour les disponibilités uniquement
  const widget_dispo = new IngenieWidgetDispoResa.Client({
    code: "HLOBFC025334000496",
    url: "https://www.destination-haut-doubs.com",
    elementHtml: "widget-fiche-ingenie-dispo",
    enable_dispo: true,
    enable_resa: false,
    styles: {
      direction: "horizontal",
      responsiveAt: "900",
      inlineLabels: true,
    },
    dispo: {
      options: {
        templates: {},
      },
    },
  });

  widget_dispo.init();

  // The widget re-lays itself out while loading (months stacked, then a slider):
  // keep it hidden until its height settles so it causes no layout shift
  const widgetElement = document.getElementById("widget-fiche-ingenie-dispo");
  let lastHeight = -1;
  let checks = 0;
  const revealWhenStable = setInterval(() => {
    const height = widgetElement.offsetHeight;
    checks += 1;
    if ((height > 0 && height === lastHeight) || checks > 40) {
      clearInterval(revealWhenStable);
      widgetElement.classList.remove("invisible");
    }
    lastHeight = height;
  }, 150);
</script>
