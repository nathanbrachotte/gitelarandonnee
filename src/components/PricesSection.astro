---
import { H2, H3 } from "@/components/Typography";
import { ArrivalDepartureAlert } from "@/components/Alerts";
import {
  MAX_PERSONS,
  PRICE_EXAMPLE,
  PRICE_EXTRAS,
  PRICE_GROUPS,
} from "@/data.constants";

const perPerson = (price: number) => Math.round(price / MAX_PERSONS);
const example = PRICE_EXAMPLE;
---

<div class="flex flex-col gap-4">
  <H2>Nos tarifs</H2>
  <div class="overflow-x-auto">
    <table class="w-full text-left">
      <thead>
        <tr class="border-b-2">
          <th class="py-2 pr-4">Période</th>
          <th class="py-2 pr-4">Prix du gîte</th>
          <th class="py-2">
            Par personne
            <span class="block text-sm font-normal">
              base {MAX_PERSONS} pers.
            </span>
          </th>
        </tr>
      </thead>
      {
        PRICE_GROUPS.map((group) => (
          <tbody>
            <tr>
              <th colspan="3" class="pt-6 pb-2 text-primary text-lg">
                {group.title}
              </th>
            </tr>
            {group.rows.map((row) => (
              <tr class="border-b">
                <td class="py-2 pr-4">{row.period}</td>
                <td class="py-2 pr-4 font-bold whitespace-nowrap">
                  {row.price} €
                </td>
                <td class="py-2 whitespace-nowrap">{perPerson(row.price)} €</td>
              </tr>
            ))}
          </tbody>
        ))
      }
    </table>
  </div>
  <p>
    Exemple : une semaine pendant les {example.period.toLowerCase()} à {
      MAX_PERSONS
    } personnes revient à {example.price} €, soit environ {
      perPerson(example.price)
    } € par personne, hors taxe de séjour.
  </p>
  <p>Pour une location en milieu de semaine, contactez-nous directement.</p>
  <div>
    <H3>Options et taxes</H3>
    <ul class="mt-2 space-y-2">
      {
        PRICE_EXTRAS.map((extra) => (
          <li>
            <span class="font-bold">{extra.label} :</span> {extra.value}
          </li>
        ))
      }
    </ul>
  </div>
  <ArrivalDepartureAlert />
</div>
