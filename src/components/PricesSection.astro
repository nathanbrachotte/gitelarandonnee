---
import { H2, H3 } from "@/components/Typography";
import { ArrivalDepartureAlert } from "@/components/Alerts";
import { PRICE_EXTRAS, PRICE_GROUPS } from "@/data.constants";
---

<div class="flex flex-col gap-4">
  <H2 id="tarifs" className="scroll-mt-28">Nos tarifs</H2>
  <div class="overflow-x-auto">
    <table class="w-full text-left">
      <thead>
        <tr class="border-b-2">
          <th class="py-2 pr-4">Période</th>
          <th class="py-2">Prix du gîte</th>
        </tr>
      </thead>
      {
        PRICE_GROUPS.map((group) => (
          <tbody>
            <tr>
              <th colspan="2" class="pt-6 pb-2 text-primary text-lg">
                {group.title}
              </th>
            </tr>
            {group.rows.map((row) => (
              <tr class="border-b">
                <td class="py-2 pr-4">{row.period}</td>
                <td class="py-2 font-bold whitespace-nowrap">{row.price} €</td>
              </tr>
            ))}
          </tbody>
        ))
      }
    </table>
  </div>
  <p>Pour une location en milieu de semaine, contactez-nous directement.</p>
  <div>
    <H3>Options et taxes</H3>
    <ul class="mt-2 space-y-2">
      {
        PRICE_EXTRAS.map((extra) => (
          <li>
            <span class="font-bold">{extra.label} :</span> {extra.value}
          </li>
        ))
      }
    </ul>
  </div>
  <div id="horaires" class="scroll-mt-28">
    <ArrivalDepartureAlert />
  </div>
</div>
